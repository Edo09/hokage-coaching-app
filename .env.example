# Copy to .env for local development. For builds, set the same variables in
# EAS (expo.dev → project → Environment variables) for preview + production.

# Supabase project (Settings → API): URL + anon public key. Never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://rzgwkwxskrovxnnymxqo.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<anon public key>

# AI meal estimation + weekly insight (Groq first, Gemini fallback).
# NOTE: EXPO_PUBLIC_* values are embedded in the app bundle and can be extracted.
EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_GEMINI_API_KEY=

# Public privacy policy page (served by the web panel). The Ajustes row is hidden while unset.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://<panel-domain>/privacidad.html
