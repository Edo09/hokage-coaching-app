# Copy to .env for local development. For builds, set the same variables in
# EAS (expo.dev → project → Environment variables) for preview + production.

# Supabase project (Settings → API): URL + anon public key. Never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://rzgwkwxskrovxnnymxqo.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<anon public key>

# AI meal estimation + weekly insight run in the ai-complete Edge Function; the
# model keys are function secrets, never app env (EXPO_PUBLIC_* values are
# embedded in the app bundle). See docs/ADMIN_WEB_DB_CONNECTION.md §6.4.

# Public privacy policy page (served by the web panel). The Ajustes row is hidden while unset.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://<panel-domain>/privacidad.html

# Premium subscriptions (RevenueCat), docs/ADMIN_WEB_DB_CONNECTION.md §6.7.
# PUBLIC SDK keys only (iOS `appl_…`, Android `goog_…`), one per store; never the
# secret API key, which is a function secret. Set them per EAS environment like
# the Supabase ones. While both are unset the app shows no purchase UI at all.
# RevenueCat's Test Store key (`test_…`) goes ONLY in the EAS `development`
# environment: a release build (preview, TestFlight, Play test tracks) crashes
# with it, so the app ignores a `test_…` key outside a dev client.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# The paywall's Terms of Use link. Unset: Apple's standard EULA on iOS, no link on Android.
EXPO_PUBLIC_TERMS_OF_USE_URL=
